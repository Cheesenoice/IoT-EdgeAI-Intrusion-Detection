# ============================================================
# SENTINEL EYE - Environment Configuration Template
# Copy this file to '.env' and fill in your actual settings:
#   cp .env.example .env
# ============================================================

# ESP32-CAM IP Address (Check on PlatformIO Serial Monitor)
ESP32_IP=192.168.1.100

# Flask Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG_MODE=True

# Email Alert Configuration (Gmail SMTP)
# Note: For Gmail, you must generate an App Password (16 characters):
# Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_ALERT_ENABLED=True
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here
RECEIVER_EMAIL=receiver_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
